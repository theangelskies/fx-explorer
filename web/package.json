{
  "name": "fx-explorer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "fx-explorer web UI, built only from ../openapi.yaml",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
