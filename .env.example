# Copy this file to .env and change the values.

# --- PostgreSQL container (used by docker-compose.yml) ---
POSTGRES_USER=fx
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fx_explorer

# --- App settings (read by src/fx_explorer/config.py) ---
# Port 5433 on your machine maps to 5432 inside the container.
# Keep the password the same as POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://fx:change_me@localhost:5433/fx_explorer
TEST_DATABASE_URL=postgresql://fx:change_me@localhost:5433/fx_explorer_test

FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
HTTP_TIMEOUT_SECONDS=10
MAX_RETRIES=3
REQUEST_DELAY_SECONDS=1
DEFAULT_BASE=EUR
DEFAULT_QUOTES=USD,GBP,NGN,JPY,CHF,CAD
